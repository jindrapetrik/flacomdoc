                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="DOMFontItem" minOccurs="0" maxOccurs="unbounded">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en">Font used in the document.</xs:documentation>
