                    <xs:attribute name="displayStyle" default="solid">
                        <xs:annotation>
                            <xs:documentation xml:lang="en">Display style for the IK tree.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                            <xs:restriction base="xs:string">
                                <xs:enumeration value="wire"/>
                                <xs:enumeration value="solid"/>
                                <xs:enumeration value="line"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="connectionIndices">
                        <xs:annotation>
                            <xs:documentation xml:lang="en">Indices of connections in the IK tree. (comma-separated list of floats)</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                            <xs:restriction base="xs:string">
                                <xs:pattern value="(\s*-?\d+(\.\d+)?\s*,)*\s*-?\d+(\.\d+)?\s*"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="connectionData">
                        <xs:annotation>
                            <xs:documentation xml:lang="en">Data for connections in the IK tree. (comma-separated list of floats)</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                            <xs:restriction base="xs:string">
                                <xs:pattern value="(\s*-?\d+(\.\d+)?\s*,)*\s*-?\d+(\.\d+)?\s*"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>                    
                </xs:complexType>
            </xs:element>
        </xs:sequence>
        
        <xs:attribute name="index" type="xs:integer" use="required">
            <xs:annotation>
                <xs:documentation xml:lang="en">Index of the frame within the layer. (0-based)</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="duration" type="xs:integer" use="optional" default="1">
            <xs:annotation>
                <xs:documentation xml:lang="en">Duration of the frame in frames.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="isMotionObject" type="xs:boolean" use="optional"/>
<xs:attribute name="visibleAnimationKeyframes" type="xs:unsignedInt" use="optional"/>
<xs:attribute name="tweenInstanceName" type="xs:string" use="optional"/>
<xs:attribute name="keyMode" type="xs:integer" use="required">
            <xs:annotation>
                <xs:documentation xml:lang="en"><![CDATA[
        <h1>
            Unsure: Key mode flags for the frame.
        </h1>
        <p>
        The value seems to be a bitmask that defines various properties of the frame's tweening behavior.
        </p>
        The following are the possible key mode values:

        <h2>tweenType = "none":</h2>
        <p>
        0x2600 (9728 dec)
        </p>
        <h2>tweenType = "motion":</h2>
        <p>
        0x4001 +<br />
        <table>
            <tr><td>0x0100</td><td>motionTweenOrientToPath = true</td></tr>
            <tr><td>0x0200</td><td>motionTweenScale = true</td></tr>
            <tr><td>0x0400</td><td>motionTweenRotate &lt;&gt; none</td></tr>
            <tr><td>0x0800</td><td>motionTweenSync = true</td></tr>
            <tr><td>0x1000</td><td>motionTweenSnap = true</td></tr>
        </table>
        (default: only motionTweenSnap = true)
        </p>

        <h2>tweenType = "shape":</h2>
        <p>
        0x4602 (17922 dec)
        </p>

        <h2>tweenType = "motion object":</h2>
        <p>
        0x2003 + 0x0800	motionTweenSync "Sync graphic symbols"
        </p>
        <p>
        The second byte seems to be tween type index.
        </p>
                    ]]>
                </xs:documentation>
            </xs:annotation>        
        </xs:attribute>

        <xs:attribute name="tweenType" use="optional" default="none">
            <xs:annotation>
                <xs:documentation xml:lang="en">Type of tween applied to the frame.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="none"/>
                    <xs:enumeration value="motion"/>
                    <xs:enumeration value="shape"/>
                    <xs:enumeration value="motion object"/>
                    <xs:enumeration value="IK pose"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="shapeTweenBlend" use="optional" default="distributive">
            <xs:annotation>
                <xs:documentation xml:lang="en">Type of blending used for shape tweens.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="distributive"/>
                    <xs:enumeration value="angular"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="acceleration" use="optional" default="0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Easing value for tweens. 
                    Range: -100 to 100. 
                    -100 here = "100 out" in IDE, 
                    100 here = "-100 in" in IDE.
                    0 = no easing.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:integer">
                    <xs:minInclusive value="-100"/>
                    <xs:maxInclusive value="100"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="motionTweenSnap" type="xs:boolean" use="optional" default="false">
            <xs:annotation>
                <xs:documentation xml:lang="en">Whether to snap the motion tween.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="motionTweenOrientToPath" type="xs:boolean" use="optional" default="false">
            <xs:annotation>
                <xs:documentation xml:lang="en">Whether the motion tween is oriented to the path.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="motionTweenScale" type="xs:boolean" use="optional">
            <xs:annotation>
                <xs:documentation xml:lang="en">Whether scaling is interpolated in a classic motion tween. Also encoded by bit 0x0200 of keyMode.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="motionTweenSync" type="xs:boolean" use="optional" default="false">
            <xs:annotation>
                <xs:documentation xml:lang="en">Whether the motion tween is synchronized with the timeline.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="motionTweenRotate" default="none">
            <xs:annotation>
                <xs:documentation xml:lang="en">Rotation behavior for the motion tween.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="none"/>
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="clockwise"/>
                    <xs:enumeration value="counter-clockwise"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="motionTweenRotateTimes" type="xs:nonNegativeInteger" use="optional" default="0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Number of times to rotate during the motion tween.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="useSingleEaseCurve" type="xs:boolean" use="optional" default="true">
            <xs:annotation>
                <xs:documentation xml:lang="en">Whether to use a single ease curve for all properties.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="hasCustomEase" type="xs:boolean" use="optional" default="false">
            <xs:annotation>
                <xs:documentation xml:lang="en">Whether the frame has a custom ease curve.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="soundName" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation xml:lang="en">Name of the sound associated with the frame.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="soundLoop" type="xs:integer" use="optional" default="1">
            <xs:annotation>
                <xs:documentation xml:lang="en">Number of times the sound should loop.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="soundLoopMode" default="repeat">
            <xs:annotation>
                <xs:documentation xml:lang="en">Loop mode for the sound.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="repeat"/>
                    <xs:enumeration value="loop"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="inPoint44" type="xs:integer" use="optional" default="0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Point in time for sound to start. Measured in 44kHz samples.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="outPoint44" type="xs:integer" use="optional" default="0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Point in time for sound to stop. Measured in 44kHz samples.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="soundZoomLevel" type="xs:integer" use="optional">
            <xs:annotation>
                <xs:documentation xml:lang="en">Zoom level for the sound.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="soundEffect" default="none">
            <xs:annotation>
                <xs:documentation xml:lang="en">Sound effect applied to the sound.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="none"/>
                    <xs:enumeration value="left channel"/>
                    <xs:enumeration value="right channel"/>
                    <xs:enumeration value="fade left to right"/>
                    <xs:enumeration value="fade right to left"/>
                    <xs:enumeration value="fade in"/>
                    <xs:enumeration value="fade out"/>
                    <xs:enumeration value="custom"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="soundSync" default="event">
            <xs:annotation>
                <xs:documentation xml:lang="en">Sound synchronization mode.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="event"/>
                    <xs:enumeration value="start"/>
                    <xs:enumeration value="stop"/>
                    <xs:enumeration value="stream"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="name" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation xml:lang="en">Name of the frame.</xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="labelType" default="none">
            <xs:annotation>
                <xs:documentation xml:lang="en">Type of label for the frame.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="none"/>
                    <xs:enumeration value="name"/>
                    <xs:enumeration value="comment"/>
                    <xs:enumeration value="anchor"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="bookmark" type="xs:boolean" default="false"/>
        <xs:attribute name="isIKPose" type="xs:boolean" default="false">
            <xs:annotation>
                <xs:documentation xml:lang="en">Indicates if the frame is an Inverse Kinematics (IK) pose.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>
    
