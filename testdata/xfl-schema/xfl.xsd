        <xs:attribute name="isSelectable" type="xs:boolean" default="true">
            <xs:annotation>
                <xs:documentation xml:lang="en">Specifies whether the text is selectable.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="orientation" default="horizontal">
            <xs:annotation>
                <xs:documentation xml:lang="en">Orientation of the text.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:string">
