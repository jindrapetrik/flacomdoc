                                            <xs:attribute name="duration" type="xs:integer" use="required">
                                                <xs:annotation>
                                                    <xs:documentation xml:lang="en">Duration of the IK state in frames.</xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                            <xs:attributeGroup ref="tns:IKStateEaseAttributes"/>
