        </xs:attribute>
        <xs:attribute name="border" type="xs:boolean" default="false">
            <xs:annotation>
                <xs:documentation xml:lang="en">Specifies whether the text field should have a border.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="lineType" default="single line">
            <xs:annotation>
