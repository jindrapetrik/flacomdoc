                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="physicsEnabled" type="xs:boolean" default="false">
                        <xs:annotation>
                            <xs:documentation xml:lang="en">Enable springs.</xs:documentation>
                        </xs:annotation>
                    </xs:attribute>  
                    <xs:attribute name="exportType" default="authortime">
                        <xs:annotation>
                            <xs:documentation xml:lang="en">Type of export for the IK tree.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                            <xs:restriction base="xs:string">
