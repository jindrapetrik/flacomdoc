                                <xs:complexType>
                                    <xs:attribute name="name" type="xs:string" use="required">
                                        <xs:annotation>
                                            <xs:documentation xml:lang="en">Name of the font. Unique identifier for the font.</xs:documentation>
                                        </xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="itemID" type="tns:ItemIdType" use="optional">
                                        <xs:annotation>
                                            <xs:documentation xml:lang="en">Unique identifier for the font.</xs:documentation>
                                        </xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="font" type="xs:string" use="required">
                                        <xs:annotation>
                                            <xs:documentation xml:lang="en">Font family name.</xs:documentation>
                                        </xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="size" type="xs:integer" use="required">
                                        <xs:annotation>
                                            <xs:documentation xml:lang="en">Font size in points.</xs:documentation>
                                        </xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="id" type="xs:integer" use="required">
                                        <xs:annotation>
                                            <xs:documentation xml:lang="en">Unique identifier for the font item.</xs:documentation>
                                        </xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="sourceLastImported" type="xs:integer" use="required">
