                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="pins" minOccurs="0">
                <xs:annotation><xs:documentation xml:lang="en">Archived IK pin positions in XFL integer-point notation.</xs:documentation></xs:annotation>
                <xs:complexType><xs:sequence><xs:element name="Pin" maxOccurs="unbounded"><xs:complexType><xs:attribute name="integerPoint" type="xs:string" use="required"/></xs:complexType></xs:element></xs:sequence></xs:complexType>
            </xs:element>
            <xs:element name="worldMatrix" minOccurs="0" maxOccurs="1" type="tns:MatrixContainerType"/>
            <xs:element name="childNodes" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="ChildNode" type="tns:IKNodeType" minOccurs="0" maxOccurs="unbounded">
                            <xs:annotation>
                                <xs:documentation xml:lang="en">Child IK node.</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation xml:lang="en">Name of the child IK node.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="boneName" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation xml:lang="en">Name of the bone.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="location" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation xml:lang="en">Location of the bone in the hex format "#x.y, #x.y".</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="xArray" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation xml:lang="en">X coordinate array for the bone.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="yArray" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation xml:lang="en">Y coordinate array for the bone.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="angleArray" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation xml:lang="en">Angle array for the bone.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="referenceID" type="tns:ReferenceType" use="optional">
            <xs:annotation>
                <xs:documentation xml:lang="en">Reference ID of the bone.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="speed" use="optional" default="100.0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Speed of the bone. Native XFL range 0.0 to 100.0; archived normalized values usually use 0.0 to 1.0.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:float">
                    <xs:minInclusive value="0.0"/>
                    <xs:maxInclusive value="100.0"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="rotationEnabled" type="xs:boolean" use="optional" default="true">
            <xs:annotation>
                <xs:documentation xml:lang="en">Enable joint rotation.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        
        <xs:attribute name="rotationConstrained" type="xs:boolean" use="optional" default="false">
            <xs:annotation>
                <xs:documentation xml:lang="en">Indicates if rotation is constrained for the joint.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="rotationMin" type="xs:float" use="optional" default="0.0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Minimum rotation angle for the joint.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="rotationMax" type="xs:float" use="optional" default="0.0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Maximum rotation angle for the joint.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="xTranslationEnabled" type="xs:boolean" use="optional" default="false">
            <xs:annotation>
                <xs:documentation xml:lang="en">Indicates if X translation is enabled for the joint.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="xTranslationConstrained" type="xs:boolean" use="optional" default="false">
            <xs:annotation>
                <xs:documentation xml:lang="en">Indicates if X translation is constrained for the joint.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="xTranslationMin" type="xs:float" use="optional" default="0.0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Minimum X translation for the joint.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="xTranslationMax" type="xs:float" use="optional" default="0.0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Maximum X translation for the joint.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="yTranslationEnabled" type="xs:boolean" use="optional" default="false">
            <xs:annotation>
                <xs:documentation xml:lang="en">Indicates if Y translation is enabled for the joint.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="yTranslationConstrained" type="xs:boolean" use="optional" default="false">
            <xs:annotation>
                <xs:documentation xml:lang="en">Indicates if Y translation is constrained for the joint.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="yTranslationMin" type="xs:float" use="optional" default="0.0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Minimum Y translation for the joint.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="yTranslationMax" type="xs:float" use="optional" default="0.0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Maximum Y translation for the joint.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="springStrength" type="xs:float" use="optional" default="0.0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Spring strength.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="dampingValue" type="xs:float" use="optional" default="0.0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Damping value.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="nodeType" default="undefined">
            <xs:annotation>
                <xs:documentation xml:lang="en">Type of the IK node.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="undefined"/>
                    <xs:enumeration value="lsd"/>
                    <xs:enumeration value="ik"/>
                    <xs:enumeration value="shape"/>
                    <xs:enumeration value="symbol"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="locked" type="xs:boolean" default="false">
            <xs:annotation><xs:documentation xml:lang="en">Editor lock state of this IK node.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attributeGroup ref="tns:SelectableAttributeGroup"></xs:attributeGroup>
    </xs:complexType>

    <xs:complexType name="DOMFrameType">
        
        <xs:sequence>            
        <xs:element name="Actionscript" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="en">ActionScript code associated with the frame.</xs:documentation>
                </xs:annotation>
                <xs:complexType><xs:complexContent><xs:extension base="tns:ActionscriptType"/></xs:complexContent></xs:complexType>
            </xs:element>
            <xs:element name="MorphShape" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="en">Morph shape data for shape tweens.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="morphSegments">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="MorphSegment" minOccurs="0" maxOccurs="unbounded">
                                        <xs:complexType>
                                            <xs:sequence>
                                                <xs:element name="MorphCurves" maxOccurs="unbounded">
                                                    <xs:complexType>
                                                        <xs:attribute name="controlPointA" type="xs:string">
                                                            <xs:annotation>
                                                                <xs:documentation xml:lang="en">Control point of the curve in morph segment in first shape.</xs:documentation>
                                                            </xs:annotation>
                                                        </xs:attribute>
                                                        <xs:attribute name="anchorPointA" type="xs:string">
                                                            <xs:annotation>
                                                                <xs:documentation xml:lang="en">Anchor point of the curve in morph segment in first shape.</xs:documentation>
                                                            </xs:annotation>
                                                        </xs:attribute>
                                                        <xs:attribute name="controlPointB" type="xs:string">
                                                            <xs:annotation>
                                                                <xs:documentation xml:lang="en">Control point of the curve in morph segment in second shape.</xs:documentation>
                                                            </xs:annotation>
                                                        </xs:attribute>
                                                        <xs:attribute name="anchorPointB" type="xs:string">
                                                            <xs:annotation>
                                                                <xs:documentation xml:lang="en">Anchor point of the curve in morph segment in second shape.</xs:documentation>
                                                            </xs:annotation>
                                                        </xs:attribute>
                                                        <xs:attribute name="isLine" type="xs:boolean" use="optional" default="false">
                                                            <xs:annotation>
                                                                <xs:documentation xml:lang="en">Whether the curve is a straight line.</xs:documentation>
                                                            </xs:annotation>
                                                        </xs:attribute>
                                                    </xs:complexType>
                                                </xs:element>
                                            </xs:sequence>
                                            <xs:attribute name="startPointA" type="xs:string" use="required">
                                                <xs:annotation>
                                                    <xs:documentation xml:lang="en">Starting point of the curves in morph segment in first shape.</xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                            <xs:attribute name="startPointB" type="xs:string" use="required">
                                                <xs:annotation>
                                                    <xs:documentation xml:lang="en">Starting point of the curves in morph segment in second shape.</xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                            <xs:attribute name="strokeIndex1" type="xs:integer" use="optional" default="-1">
                                                <xs:annotation>
                                                    <xs:documentation xml:lang="en">Index of the stroke in the first shape.</xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                            <xs:attribute name="strokeIndex2" type="xs:integer" use="optional" default="-1">
                                                <xs:annotation>
                                                    <xs:documentation xml:lang="en">Index of the stroke in the second shape.</xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                            <xs:attribute name="fillIndex1" type="xs:integer" use="optional" default="-1">
                                                <xs:annotation>
                                                    <xs:documentation xml:lang="en">Index of the fill in the first shape.</xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                            <xs:attribute name="fillIndex2" type="xs:integer" use="optional" default="-1">
                                                <xs:annotation>
                                                    <xs:documentation xml:lang="en">Index of the fill in the second shape.</xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="morphHintsList">
                            <xs:annotation>
                                <xs:documentation xml:lang="en">Shape-tween hint pairs. Point attributes use the native XFL integer-point coordinate format.</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="MorphHint" minOccurs="0" maxOccurs="unbounded">
                                        <xs:complexType>
                                            <xs:attribute name="startPoint" type="xs:string" use="required"/>
                                            <xs:attribute name="endPoint" type="xs:string" use="required"/>
                                            <xs:attribute name="key" type="xs:int" default="-1"/>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                    <xs:attribute name="acceleration" default="0"><xs:annotation><xs:documentation xml:lang="en">Shape tween easing, independent of mappingType.</xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:int"><xs:minInclusive value="-100"/><xs:maxInclusive value="100"/></xs:restriction></xs:simpleType></xs:attribute>
                    <xs:attribute name="mappingType" default="distributive">
                        <xs:annotation>
                            <xs:documentation xml:lang="en">Type of mapping used for the shape tween.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                            <xs:restriction base="xs:string">
                                <xs:enumeration value="distributive"/>
                                <xs:enumeration value="angular vertex"/>
                                <xs:enumeration value="random distribution"/>
                                <xs:enumeration value="linear walk"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                </xs:complexType>
            </xs:element>
            <xs:element name="SoundEnvelope" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="en">Sound envelope points for sound effects.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="SoundEnvelopePoint" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                                <xs:attribute name="mark44" type="xs:nonNegativeInteger" default="0">
                                    <xs:annotation>
                                        <xs:documentation xml:lang="en">Position of the envelope point in 44kHz samples.</xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                                <xs:attribute name="level0" default="0">
                                    <xs:annotation>
                                        <xs:documentation xml:lang="en">Volume level of the left channel. 0-65535.</xs:documentation>
                                    </xs:annotation>
                                    <xs:simpleType>
                                        <xs:restriction base="xs:integer">
                                            <xs:minInclusive value="0"/>
