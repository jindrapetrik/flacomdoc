                        <xs:annotation>
                            <xs:documentation xml:lang="en">Custom thickness and sharpness mode. Enables antiAliasSharpness and antiAliasThickness attributes.</xs:documentation>
                        </xs:annotation>
                    </xs:enumeration>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="left" type="xs:float" default="0.0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Left position of the text object.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="top" type="xs:float" default="0.0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Top position of the text object.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="width" type="xs:float" default="0.0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Width of the text object.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="height" type="xs:float" default="0.0">
            <xs:annotation>
                <xs:documentation xml:lang="en">Height of the text object.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="scrollable" type="xs:boolean" default="false">
            <xs:annotation>
                <xs:documentation xml:lang="en">Specifies whether the text object allows scrolling.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="autoExpand" type="xs:boolean" default="false">
            <xs:annotation>
                <xs:documentation xml:lang="en">Unsure: Specifies whether the text object automatically expands to fit its content.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="includeOutlines" type="xs:boolean" default="false">
            <xs:annotation>
                <xs:documentation xml:lang="en">Unsure: Specifies whether the text object includes outlines.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attributeGroup ref="tns:SelectableAttributeGroup"/>
    <xs:attributeGroup ref="tns:AccessibilityAttributeGroup"/>
        <xs:attribute name="referenceID" type="tns:ReferenceType"/>
