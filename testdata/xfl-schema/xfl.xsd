                                                </xs:simpleType>
                                            </xs:attribute>
                                            <xs:attribute name="paddingLeft" type="tns:TlfNonnegativeNumberType" use="optional">
                                                <xs:annotation>
                                                    <xs:documentation xml:lang="en">Left padding of the TLF text object.</xs:documentation>
