            <xs:element name="GradientGlowFilter" type="tns:GradientFilterType" />
            <xs:element name="GradientBevelFilter" type="tns:GradientFilterType" />
            <xs:element name="AdjustColorFilter">
                <xs:complexType>
                    <xs:attribute name="brightness" use="optional" default="0.0">
                        <xs:annotation>
                            <xs:documentation xml:lang="en">Brightness adjustment value. +-percentage</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                            <xs:restriction base="xs:float">
                                <xs:minInclusive value="-100"/>
                                <xs:maxInclusive value="100"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="contrast" use="optional" default="0.0">
                        <xs:annotation>
                            <xs:documentation xml:lang="en">Contrast adjustment value. +-percentage</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                            <xs:restriction base="xs:float">
                                <xs:minInclusive value="-100"/>
                                <xs:maxInclusive value="100"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="saturation" use="optional" default="0.0">
                        <xs:annotation>
                            <xs:documentation xml:lang="en">Saturation adjustment value. +-percentage</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                            <xs:restriction base="xs:float">
                                <xs:minInclusive value="-100"/>
                                <xs:maxInclusive value="100"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="hue" use="optional" default="0.0">
